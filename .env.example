# 이 파일을 복사해서 ".env" 파일을 만들고 실제 값을 채워 넣으세요.
#   cp .env.example .env
# .env 파일은 절대 git에 커밋하지 마세요 (.gitignore에 이미 등록되어 있습니다).

# ==== WordPress (5단계: 발행) ====
WORDPRESS_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# ==== LLM API (3, 6~9단계: 콘텐츠 생성) ====
# OpenAI 또는 Anthropic 중 사용할 것만 채우면 됩니다.
# 현재 clients/llm_client.py 는 Anthropic Claude API만 실제로 연동되어 있습니다.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ==== Google Search Console (10단계: 성과 기록) ====
GOOGLE_SEARCH_CONSOLE_CREDENTIALS_PATH=
GOOGLE_SEARCH_CONSOLE_SITE_URL=

# ==== Threads / Meta (6단계) ====
THREADS_ACCESS_TOKEN=

# ==== 공통 설정 ====
APP_ENV=development
LOG_LEVEL=INFO
