# 이 파일을 복사해서 ".env" 파일을 만들고 실제 값을 채워 넣으세요.
#   cp .env.example .env
# .env 파일은 절대 git에 커밋하지 마세요 (.gitignore에 이미 등록되어 있습니다).

# ==== WordPress (5단계: 발행) ====
WORDPRESS_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=
# 아래 두 값의 기본값은 반드시 true로 유지하세요. 운영자가 의도적으로
# false로 바꾸기 전에는 품질 검사를 통과해도 자동으로 공개 발행되지
# 않습니다(항상 draft로만 만들어집니다).
WORDPRESS_DRY_RUN=true
WORDPRESS_DRAFT_FIRST=true
# 같은 slug의 글이 이미 있을 때: skip(기본, 아무것도 안 함) | draft_update(기존 draft만 갱신, 이미 발행된 글은 절대 건드리지 않음)
WORDPRESS_EXISTING_POST_POLICY=skip
WORDPRESS_MAX_RETRIES=2
WORDPRESS_TIMEOUT_SECONDS=30

# ==== LLM API (3, 6~9단계: 콘텐츠 생성) ====
# OpenAI 또는 Anthropic 중 사용할 것만 채우면 됩니다.
# 현재 clients/llm_client.py 는 Anthropic Claude API만 실제로 연동되어 있습니다.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ==== Google Search Console (10단계: 성과 기록) ====
GOOGLE_SEARCH_CONSOLE_CREDENTIALS_PATH=
GOOGLE_SEARCH_CONSOLE_SITE_URL=

# ==== Threads / Meta (6단계) ====
THREADS_ACCESS_TOKEN=

# ==== 공통 설정 ====
APP_ENV=development
LOG_LEVEL=INFO
